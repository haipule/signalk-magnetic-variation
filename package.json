{
  "name": "signalk-magnetic-variation",
  "version": "0.1.0",
  "description": "Signal K server plugin that publishes WMM2025 magnetic variation from vessel position",
  "main": "index.js",
  "type": "commonjs",
  "files": [
    "CHANGELOG.md",
    "docs/",
    "LICENSE",
    "README.md",
    "index.js",
    "lib/"
  ],
  "scripts": {
    "check": "node --check index.js && node --check lib/calculator.js && node --check test/calculator.test.js && node --check test/plugin.test.js",
    "test": "node --test",
    "prepublishOnly": "npm run check && npm test"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "magvar": "2.0.1"
  },
  "keywords": [
    "signalk-node-server-plugin",
    "signalk-category-utility",
    "signalk",
    "magnetic-variation",
    "magnetic-declination",
    "wmm",
    "wmm2025",
    "marine-navigation"
  ],
  "author": "haipule",
  "license": "Apache-2.0",
  "homepage": "https://github.com/haipule/signalk-magnetic-variation#readme",
  "bugs": {
    "url": "https://github.com/haipule/signalk-magnetic-variation/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/haipule/signalk-magnetic-variation.git"
  },
  "signalk-plugin-enabled-by-default": false,
  "signalk": {
    "displayName": "WMM2025 Magnetic Variation"
  }
}
